<template>
  <view class="page">
    <view class="card">
      <view class="title">{{ roleTitle }}登录</view>
      <view class="subtitle">使用手机号或邮箱验证码登录</view>

      <view class="form-item">
        <text class="label">手机号 / 邮箱</text>
        <input v-model="form.account" class="input" placeholder="请输入手机号或邮箱" />
      </view>

      <view class="form-item code-item">
        <text class="label">验证码</text>
        <view class="code-row">
          <input v-model="form.code" class="input code-input" placeholder="6位验证码" type="number" maxlength="6" />
          <button class="code-btn" :disabled="counting > 0" @click="sendCode">
            {{ counting > 0 ? `${counting}s` : '获取验证码' }}
          </button>
        </view>
      </view>

      <view v-if="errorMsg" class="error">{{ errorMsg }}</view>

      <button class="btn" type="primary" :loading="loading" @click="handleLogin">登录</button>
      <button class="back-btn" @click="goBack">返回</button>

      <view class="tip" v-if="role === 'teacher'">测试账号：13800000001</view>
      <view class="tip" v-if="role === 'admin'">测试账号：13900000001</view>
    </view>
  </view>
</template>

<script lang="ts">
import { findStaffByAccount } from '@/utils/userData.uts'

export default {
  data() {
    return {
      role: 'teacher',
      form: { account: '', code: '' },
      errorMsg: '',
      loading: false,
      counting: 0,
      timer: null as number | null,
      mockServerCode: '',
    }
  },
  computed: {
    roleTitle(): string {
      return this.role === 'teacher' ? '教师' : '管理员'
    }
  },
  onLoad(options: any) {
    if (options && options.role) {
      this.role = options.role
    }
  },
  onUnload() {
    if (this.timer !== null) clearInterval(this.timer)
  },
  methods: {
    sendCode() {
      if (!this.form.account) {
        this.errorMsg = '请先输入手机号或邮箱'
        return
      }

      const matched = findStaffByAccount(this.form.account, this.role)
      if (!matched) {
        this.errorMsg = '该账号不存在，请检查'
        return
      }

      this.errorMsg = ''
      const randomCode = Math.floor(100000 + Math.random() * 900000).toString()
      this.mockServerCode = randomCode

      uni.showModal({
        title: '模拟短信/邮件',
        content: `您的验证码是：${randomCode}`,
        showCancel: false,
        confirmText: '我知道了'
      })

      this.counting = 60
      this.timer = setInterval(() => {
        this.counting--
        if (this.counting <= 0 && this.timer) {
          clearInterval(this.timer)
          this.timer = null
        }
      }, 1000) as unknown as number
    },
    handleLogin() {
      this.errorMsg = ''
      if (!this.form.account || !this.form.code) {
        this.errorMsg = '请填写完整信息'
        return
      }

      if (!this.mockServerCode) {
        this.errorMsg = '请先获取验证码'
        return
      }
      if (this.form.code !== this.mockServerCode) {
        this.errorMsg = '验证码错误，请重新输入'
        return
      }

      this.loading = true
      setTimeout(() => {
        const matched = findStaffByAccount(this.form.account, this.role)
        this.loading = false

        if (!matched) {
          this.errorMsg = '账号不存在或不属于该身份'
          return
        }

        uni.showToast({ title: '登录成功', icon: 'success' })

        if (matched.role === 'admin') {
          uni.navigateTo({ url: `/pages/admin/index?name=${encodeURIComponent(matched.name)}` })
        } else if (matched.role === 'teacher') {
          uni.navigateTo({ url: `/pages/teacher/index?name=${encodeURIComponent(matched.name)}` })
        } else {
          uni.navigateTo({
            url: `/pages/student/signin?name=${encodeURIComponent(matched.name)}&studentNo=${encodeURIComponent(matched.studentNo)}&role=${matched.role}`,
          })
        }
      }, 500)
    },
    goBack() { uni.navigateBack() }
  },
}
</script>

<style>
.page { min-height: 100vh; padding: 40rpx 30rpx; background-color: #f5f6fa; box-sizing: border-box; }
.card { background-color: #ffffff; border-radius: 20rpx; padding: 40rpx 30rpx; }
.title { font-size: 40rpx; font-weight: bold; color: #222; text-align: center; }
.subtitle { font-size: 26rpx; color: #999; text-align: center; margin-top: 10rpx; margin-bottom: 40rpx; }
.form-item { margin-bottom: 30rpx; }
.label { display: block; font-size: 28rpx; color: #555; margin-bottom: 12rpx; }
.input { width: 100%; height: 80rpx; padding: 0 20rpx; border: 1rpx solid #ddd; border-radius: 12rpx; font-size: 28rpx; box-sizing: border-box; background-color: #fafafa; }
.code-row { display: flex; flex-direction: row; align-items: center; justify-content: space-between; }
.code-input { flex: 1; margin-right: 20rpx; }
.code-btn { width: 220rpx; height: 80rpx; line-height: 80rpx; font-size: 26rpx; background-color: #007aff; color: #fff; border-radius: 12rpx; margin: 0; padding: 0; }
.code-btn[disabled] { background-color: #ccc; color: #fff; }
.error { color: #e54d42; font-size: 26rpx; margin-bottom: 20rpx; }
.btn { width: 100%; height: 80rpx; line-height: 80rpx; border-radius: 12rpx; font-size: 30rpx; margin-top: 20rpx; }
.back-btn { width: 100%; height: 80rpx; line-height: 80rpx; border-radius: 12rpx; font-size: 30rpx; margin-top: 20rpx; background-color: #f0f0f0; color: #555; }
.tip { margin-top: 30rpx; font-size: 24rpx; color: #999; text-align: center; }
</style>
