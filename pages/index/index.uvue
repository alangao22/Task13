<template>
  <view class="page">
    <view class="card">
      <view class="title">欢迎使用</view>
      <view class="subtitle">请选择您的身份进行登录</view>

      <view class="role-btns">
        <button class="role-btn btn-student" @click="goLogin('student')">学生登录</button>
        <button class="role-btn btn-teacher" @click="goLogin('teacher')">教师登录</button>
        <button class="role-btn btn-admin" @click="goLogin('admin')">管理员登录</button>
      </view>
    </view>
  </view>
</template>

<script lang="ts">
export default {
  onLoad() {
    // 回到身份选择页视为退出登录，清空 Agent 会话记忆。
    uni.removeStorageSync('agent_history')
  },
  methods: {
    goLogin(role: string) {
      if (role === 'student') {
        // 跳转到 login 文件夹下的 student 页面
        uni.navigateTo({ url: '/pages/login/student' })
      } else {
        // 教师和管理员共用 login 文件夹下的 staff 页面，通过参数区分
        uni.navigateTo({ url: `/pages/login/staff?role=${role}` })
      }
    },
  },
}
</script>

<style>
.page {
  min-height: 100vh;
  padding: 40rpx 30rpx;
  background-color: #f5f6fa;
  box-sizing: border-box;
}
.card {
  background-color: #ffffff;
  border-radius: 20rpx;
  padding: 40rpx 30rpx;
  margin-top: 100rpx;
}
.title {
  font-size: 44rpx;
  font-weight: bold;
  color: #222222;
  text-align: center;
}
.subtitle {
  font-size: 28rpx;
  color: #999999;
  text-align: center;
  margin-top: 10rpx;
  margin-bottom: 60rpx;
}
.role-btns {
  display: flex;
  flex-direction: column;
}
.role-btn {
  width: 100%;
  height: 100rpx;
  line-height: 100rpx;
  border-radius: 16rpx;
  font-size: 32rpx;
  margin-bottom: 30rpx;
  color: #ffffff;
}
.btn-student { background-color: #007aff; }
