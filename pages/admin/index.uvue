<template>
  <view class="page">
    <view class="header">
      <text class="title">管理员控制台</text>
      <text class="subtitle">欢迎，{{ userName }}</text>
    </view>

    <view class="menu-list">
      <navigator class="menu-card" style="background-color: #1b2340; background-image: linear-gradient(135deg, #1b2340 0%, #263a78 55%, #4c2e8a 100%); border: 1rpx solid rgba(124, 140, 255, 0.35); box-shadow: 0 12rpx 32rpx rgba(76, 46, 138, 0.28); text-decoration: none;" hover-class="none" url="/pages/admin/agent"><text class="menu-icon">✨</text><view class="menu-info"><text class="menu-title" style="color: #ffffff;">AI 助手</text><text class="menu-desc" style="color: #c3ccff;">用对话查用户、课程与签到，支持快捷指令</text></view><text class="arrow" style="color: #aab8ff;">></text></navigator>
      <view class="menu-card" @click="goPage('users')">
        <text class="menu-icon">👥</text>
        <view class="menu-info">
          <text class="menu-title">用户管理</text>
          <text class="menu-desc">新增、删除、修改用户信息</text>
        </view>
        <text class="arrow">></text>
      </view>

      <view class="menu-card" @click="goPage('courses')">
        <text class="menu-icon">📚</text>
        <view class="menu-info">
          <text class="menu-title">课程管理</text>
          <text class="menu-desc">新增、删除、修改课程数据</text>
        </view>
        <text class="arrow">></text>
      </view>

      <view class="menu-card" @click="goPage('checkins')">
        <text class="menu-icon">📝</text>
        <view class="menu-info">
          <text class="menu-title">签到管理</text>
          <text class="menu-desc">修改签到结果、删除签到记录</text>
        </view>
        <text class="arrow">></text>
      </view>
    </view>

    <button class="logout-btn" @click="goBack">退出登录</button>
  </view>
</template>

<script lang="ts">
export default {
  data() {
    return { userName: '' }
  },
  onLoad(options: any) {
    if (options && options.name) this.userName = decodeURIComponent(String(options.name))
  },
  methods: {
    goPage(type: string) {
      if (type === 'users') uni.navigateTo({ url: '/pages/admin/users' })
      else if (type === 'courses') uni.navigateTo({ url: '/pages/admin/courses' })
      else if (type === 'checkins') uni.navigateTo({ url: '/pages/admin/checkins' })
    },
    goBack() { uni.navigateBack() }
  }
}
</script>

<style>
.page { min-height: 100vh; background-color: #f5f6fa; padding: 40rpx 30rpx; box-sizing: border-box; }
.header { margin-bottom: 40rpx; padding-left: 10rpx; }
.title { font-size: 44rpx; font-weight: bold; color: #333; display: block; }
.subtitle { font-size: 28rpx; color: #888; margin-top: 10rpx; display: block; }
.menu-list { display: flex; flex-direction: column; }
.menu-card { background-color: #fff; border-radius: 20rpx; padding: 30rpx; display: flex; flex-direction: row; align-items: center; margin-bottom: 24rpx; }
.menu-icon { font-size: 50rpx; margin-right: 20rpx; }
.menu-info { flex: 1; display: flex; flex-direction: column; }
.menu-title { font-size: 32rpx; font-weight: bold; color: #222; }
.menu-desc { font-size: 24rpx; color: #999; margin-top: 6rpx; }
.arrow { color: #ccc; font-size: 32rpx; }
.logout-btn { width: 100%; height: 90rpx; line-height: 90rpx; background-color: #fff; color: #e54d42; border-radius: 16rpx; font-size: 32rpx; margin-top: 40rpx; }
</style>
