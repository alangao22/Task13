<template>
  <view class="page" :style="pageStyle">
    <scroll-view
      class="chat-scroll"
      direction="vertical"
      :scroll-with-animation="true"
      :show-scrollbar="false"
      :scroll-into-view="scrollInto"
    >
      <view class="chat-inner">
        <view v-if="messages.length === 0 && !sending" class="hero">
          <view class="hero-badge">
            <text class="hero-spark">✨</text>
          </view>
          <text class="hero-title">你好，我是签到业务助理</text>
          <text class="hero-desc">可以查询用户、课程与签到数据，也支持带二次确认的新增、修改与删除。所有操作仅作用于签到业务数据。</text>
          <view class="hero-tags">
            <text class="hero-tag">用户数据</text>
            <text class="hero-tag">课程数据</text>
            <text class="hero-tag">签到记录</text>
          </view>
        </view>

        <view
          class="msg-row"
          v-for="msg in messages"
          :key="msg.id"
          :id="msg.id"
          :class="msg.role === 'user' ? 'row-right' : 'row-left'"
        >
          <view v-if="msg.role === 'agent'" class="avatar">
            <text class="avatar-text">AI</text>
          </view>

          <view class="msg-body" :class="msg.role === 'user' ? 'msg-body-right' : ''">
            <view v-if="msg.role === 'user'" class="bubble bubble-user">
              <text class="bubble-text bubble-text-user">{{ msg.content }}</text>
            </view>

            <view
              v-else
              class="bubble bubble-agent"
              :class="{ 'bubble-refusal': isRefusal(msg.content) }"
            >
              <text v-if="isRefusal(msg.content)" class="refusal-tag">⚠ 安全提示</text>
              <text class="bubble-text">{{ msg.content }}</text>

              <view v-if="msg.type === 'card'" class="card">
                <view class="card-head">
                  <view class="card-head-left">
                    <text class="card-title">{{ msg.data.title }}</text>
                    <text class="card-sub">{{ msg.data.subtitle }}</text>
                  </view>
                  <view class="card-count">
                    <text class="card-count-text">{{ msg.data.count }}</text>
                  </view>
                </view>

                <view v-if="msg.data.items.length > 0" class="card-list">
                  <view class="card-item" v-for="(item, idx) in visibleItems(msg.data.items)" :key="idx">
                    <view class="item-main">
                      <text class="item-title">{{ item.title }}</text>
                      <text class="item-sub">{{ item.subtitle }}</text>
                    </view>
                    <text class="item-badge" :class="'badge-' + item.badgeType">{{ item.badge }}</text>
                  </view>
                </view>

                <view v-else class="card-empty">
                  <text class="card-empty-text">暂无匹配数据</text>
                </view>

                <text v-if="msg.data.items.length > 10" class="card-more">仅展示前 10 条，点击下方按钮查看全部</text>

                <view v-if="msg.data.actions.length > 0" class="card-actions">
                  <view
                    class="card-action"
                    v-for="(action, actionIndex) in msg.data.actions"
                    :key="actionIndex"
                    @click="onCardAction(action)"
                  >
                    <text class="card-action-text">{{ action.text }}</text>
                  </view>
                </view>
              </view>
            </view>
          </view>
        </view>

        <view v-if="sending" class="msg-row row-left">
          <view class="avatar">
            <text class="avatar-text">AI</text>
          </view>
          <view class="bubble bubble-agent thinking-bubble">
            <view class="thinking-dot"></view>
            <view class="thinking-dot"></view>
            <view class="thinking-dot"></view>
            <text class="thinking-text">正在检索业务数据</text>
          </view>
        </view>

        <view id="m-bottom" class="bottom-anchor"></view>
      </view>
    </scroll-view>

    <view class="composer">
      <scroll-view
        class="chips"
        direction="horizontal"
        :show-scrollbar="false"
      >
        <view class="chips-inner">
          <view
            class="chip"
            v-for="(chip, index) in chips"
            :key="index"
            @click="useChip(chip)"
          >
            <text class="chip-text">{{ chip }}</text>
          </view>
        </view>
      </scroll-view>

      <view class="input-bar">
        <input
          class="input"
          v-model="inputText"
          placeholder="输入指令，如：新增用户张三"
          placeholder-class="input-ph"
          confirm-type="send"
          :adjust-position="true"
          @confirm="send"
        />
        <view class="send-btn" :class="{ 'send-btn-active': canSend }" @click="send">
          <text class="send-icon">↑</text>
        </view>
      </view>

      <text class="disclaimer">仅处理签到业务 · 不执行系统指令与代码</text>
    </view>
  </view>
</template>

<script lang="ts">
import {
  processMessage,
  resetAgentState,
  emptyCard,
  REFUSAL_MESSAGE,
  type AgentCard,
  type AgentCardAction,
  type AgentCardItem,
  type ChatMessage
} from '@/utils/agentEngine.uts'

export default {
  data() {
    return {
      messages: [] as ChatMessage[],
      inputText: '',
      scrollInto: '',
      sending: false,
      seq: 0,
      alive: true,
      windowHeight: 0,
      chips: ['查询所有用户', '新增用户', '删除课程', '所有签到']
    }
  },
  computed: {
    canSend(): boolean {
      return !this.sending && this.inputText.trim().length > 0
    },
    pageStyle(): string {
      if (this.windowHeight > 0) return 'height: ' + this.windowHeight.toString() + 'px;'
      return 'height: 100vh;'
    }
  },
  onReady() {
    const info = uni.getWindowInfo()
    this.windowHeight = info.windowHeight
  },
  onUnload() {
    this.alive = false
    resetAgentState()
  },
  methods: {
    send() {
      if (this.sending) return
      const text = this.inputText.trim()
      if (text.length == 0) return

      this.inputText = ''
      this.appendMessage('user', 'text', text, null)
      this.sending = true
      this.scrollToBottom()

      setTimeout(() => {
        if (!this.alive) return
        const reply = processMessage(text, 'admin', '')
        this.sending = false
        if (reply.type == 'card') {
          this.appendMessage('agent', 'card', reply.content, reply.data)
        } else {
          this.appendMessage('agent', 'text', reply.content, reply.data)
        }
      }, 320)
    },
    useChip(chip: string) {
      if (this.sending) return
      this.inputText = chip
      this.send()
    },
    appendMessage(role: 'user' | 'agent', type: 'text' | 'card', content: string, data: AgentCard | null) {
      this.seq += 1
      const id = 'm-' + this.seq.toString()
      const message: ChatMessage = {
        id: id,
        role: role,
        type: type,
        content: content,
        data: data == null ? emptyCard() : data
      }
      this.messages.push(message)
      this.scrollToBottom()
    },
    scrollToBottom() {
      this.scrollInto = ''
      setTimeout(() => {
        if (!this.alive) return
        this.scrollInto = 'm-bottom'
      }, 60)
    },
    isRefusal(content: string): boolean {
      return content == REFUSAL_MESSAGE
    },
    visibleItems(items: AgentCardItem[]): AgentCardItem[] {
      return items.slice(0, 10)
    },
    onCardAction(action: AgentCardAction) {
      if (this.sending) return
      const url = action.url
      if (url != null && url.length > 0) {
        uni.navigateTo({ url: url })
        return
      }
      const actionType = action.actionType
      if (actionType == null || actionType.length == 0) return

      this.appendMessage('user', 'text', action.text, null)
      let command = '/' + actionType
      if (actionType.startsWith('/')) command = actionType
      const reply = processMessage(command, 'admin', '')
      if (reply.type == 'card') {
        this.appendMessage('agent', 'card', reply.content, reply.data)
      } else {
        this.appendMessage('agent', 'text', reply.content, reply.data)
      }
    }
  }
}
</script>

