<template>
  <view class="page" :style="pageStyle">
    <scroll-view
      class="chat-scroll"
      direction="vertical"
      :scroll-with-animation="true"
      :show-scrollbar="false"
      :scroll-into-view="scrollInto"
    >
      <view class="chat-inner">
        <view v-if="messages.length === 0 && !sending" class="hero">
          <view class="hero-badge">
            <text class="hero-spark">✨</text>
          </view>
          <text class="hero-title">你好，我是签到业务助理</text>
          <text class="hero-desc">可以查询用户、课程与签到数据，也支持带二次确认的新增、修改与删除。所有操作仅作用于签到业务数据。</text>
          <view class="hero-tags">
            <text class="hero-tag">用户数据</text>
            <text class="hero-tag">课程数据</text>
            <text class="hero-tag">签到记录</text>
          </view>
        </view>

        <view
          class="msg-row"
          v-for="msg in messages"
          :key="msg.id"
          :id="msg.id"
          :class="msg.role === 'user' ? 'row-right' : 'row-left'"
        >
          <view v-if="msg.role === 'agent'" class="avatar">
            <text class="avatar-text">AI</text>
          </view>

          <view class="msg-body" :class="msg.role === 'user' ? 'msg-body-right' : ''">
            <view v-if="msg.role === 'user'" class="bubble bubble-user">
              <text class="bubble-text bubble-text-user">{{ msg.content }}</text>
            </view>

            <view
              v-else
              class="bubble bubble-agent"
              :class="{ 'bubble-refusal': isRefusal(msg.content) }"
            >
              <text v-if="isRefusal(msg.content)" class="refusal-tag">⚠ 安全提示</text>
              <text class="bubble-text">{{ msg.content }}</text>

              <view v-if="msg.type === 'card'" class="card">
                <view class="card-head">
                  <view class="card-head-left">
                    <text class="card-title">{{ msg.data.title }}</text>
                    <text class="card-sub">{{ msg.data.subtitle }}</text>
                  </view>
                  <view class="card-count">
                    <text class="card-count-text">{{ msg.data.count }}</text>
                  </view>
                </view>

                <view v-if="msg.data.items.length > 0" class="card-list">
                  <view class="card-item" v-for="(item, idx) in visibleItems(msg.data.items)" :key="idx">
                    <view class="item-main">
                      <text class="item-title">{{ item.title }}</text>
                      <text class="item-sub">{{ item.subtitle }}</text>
                    </view>
                    <text class="item-badge" :class="'badge-' + item.badgeType">{{ item.badge }}</text>
                  </view>
                </view>

                <view v-else class="card-empty">
                  <text class="card-empty-text">暂无匹配数据</text>
                </view>

                <text v-if="msg.data.items.length > 10" class="card-more">仅展示前 10 条，点击下方按钮查看全部</text>

                <view v-if="msg.data.actions.length > 0" class="card-actions">
                  <view
                    class="card-action"
                    :class="{ 'card-action-disabled': isActionDisabled(action) }"
                    v-for="(action, actionIndex) in msg.data.actions"
                    :key="actionIndex"
                    @click="onCardAction(action, msg, actionIndex)"
                  >
                    <text
                      class="card-action-text"
                      :class="{ 'card-action-text-disabled': isActionDisabled(action) }"
                    >{{ action.text }}</text>
                  </view>
                </view>
              </view>
            </view>
          </view>
        </view>

        <view v-if="sending" class="msg-row row-left">
          <view class="avatar">
            <text class="avatar-text">AI</text>
          </view>
          <view class="bubble bubble-agent thinking-bubble">
            <view class="thinking-dot"></view>
            <view class="thinking-dot"></view>
            <view class="thinking-dot"></view>
            <text class="thinking-text">正在检索业务数据</text>
          </view>
        </view>

        <view id="m-bottom" class="bottom-anchor"></view>
      </view>
    </scroll-view>

    <view class="composer">
      <scroll-view
        v-if="suggestions.length > 0"
        class="chips"
        direction="horizontal"
        :show-scrollbar="false"
      >
        <view class="chips-inner">
          <view
            class="chip"
            v-for="(chip, index) in suggestions"
            :key="index"
            @click="useChip(chip)"
          >
            <text class="chip-text">{{ chip }}</text>
          </view>
        </view>
      </scroll-view>

      <view class="input-bar">
        <input
          class="input"
          v-model="inputText"
          placeholder="输入指令，如：新增用户张三"
          placeholder-class="input-ph"
          confirm-type="send"
          :adjust-position="true"
          @confirm="send"
        />
        <view class="send-btn" :class="{ 'send-btn-active': canSend }" @click="send">
          <text class="send-icon">↑</text>
        </view>
      </view>

      <text class="disclaimer">仅处理签到业务 · 不执行系统指令与代码</text>
    </view>
  </view>
</template>

<script lang="ts">
import {
  processMessage,
  resetAgentState,
  emptyCard,
  REFUSAL_MESSAGE,
  type AgentCard,
  type AgentCardAction,
  type AgentCardItem,
  type ChatMessage
} from '@/utils/agentEngine.uts'
import { users } from '@/utils/userData.uts'
import { type User } from '@/utils/userData.uts'
import { courses } from '@/utils/courseData.uts'
import { type Course } from '@/utils/courseData.uts'
import { checkinTable } from '@/utils/checkinData.uts'
import { chooseCSVFile, parseCSVToObjects, csvGet, exportCheckinsToCSV } from '@/utils/fileUtils.uts'

const WELCOME_TEXT = '你好，我是系统业务助理。你可以直接对我说：\n- 查一下最新签到\n- 新增用户 张三\n- 修改数据结构的上课时间'
const DEFAULT_SUGGESTIONS: string[] = ['查一下最新签到', '新增用户 张三', '修改数据结构的上课时间']

export default {
  data() {
    return {
      messages: [] as ChatMessage[],
      inputText: '',
      scrollInto: '',
      sending: false,
      seq: 0,
      alive: true,
      windowHeight: 0,
      suggestions: [] as string[]
    }
  },
  computed: {
    canSend(): boolean {
      return !this.sending && this.inputText.trim().length > 0
    },
    pageStyle(): string {
      if (this.windowHeight > 0) return 'height: ' + this.windowHeight.toString() + 'px;'
      return 'height: 100vh;'
    }
  },
  onLoad() {
    const saved = uni.getStorageSync('agent_history')
    if (saved != null && saved.length > 0) {
      const history = saved as ChatMessage[]
      let start = history.length - 20
      if (start < 0) start = 0
      this.messages = history.slice(start)
      this.seq = Date.now()
      for (let i = 0; i < this.messages.length; i++) {
        const actions = this.messages[i].data.actions
        for (let j = 0; j < actions.length; j++) {
          const actionType = actions[j].actionType
          if (actionType == 'confirm_execute' || actionType == 'cancel_action' || actionType == 'edit_info') {
            actions[j].status = 'disabled'
          }
        }
      }
      this.suggestions = DEFAULT_SUGGESTIONS
      this.scrollToBottom()
    } else {
      this.appendMessage('agent', 'text', WELCOME_TEXT, null, DEFAULT_SUGGESTIONS)
    }
  },
  onReady() {
    const info = uni.getWindowInfo()
    this.windowHeight = info.windowHeight
  },
  onUnload() {
    this.alive = false
    resetAgentState()
  },
  methods: {
    send() {
      if (this.sending) return
      const text = this.inputText.trim()
      if (text.length == 0) return

      this.inputText = ''
      this.suggestions = []
      this.appendMessage('user', 'text', text, null)
      this.sending = true
      this.scrollToBottom()

      setTimeout(() => {
        if (!this.alive) return
        const reply = processMessage(text, 'admin', '')
        this.sending = false
        const nextSuggestions: string[] = reply.suggestions == null ? [] : reply.suggestions
        if (reply.type == 'card') {
          this.appendMessage('agent', 'card', reply.content, reply.data, nextSuggestions)
        } else {
          this.appendMessage('agent', 'text', reply.content, reply.data, nextSuggestions)
        }
      }, 320)
    },
    useChip(chip: string) {
      if (this.sending) return
      this.inputText = chip
      this.send()
    },
    appendMessage(
      role: 'user' | 'agent',
      type: 'text' | 'card',
      content: string,
      data: AgentCard | null,
      suggestions: string[] = []
    ) {
      this.seq += 1
      const id = 'm-' + this.seq.toString()
      const message: ChatMessage = {
        id: id,
        role: role,
        type: type,
        content: content,
        data: data == null ? emptyCard() : data,
        suggestions: suggestions
      }
      this.messages.push(message)
      if (role == 'agent') this.suggestions = suggestions
      this.saveHistory()
      this.scrollToBottom()
    },
    saveHistory() {
      let start = this.messages.length - 20
      if (start < 0) start = 0
      if (start > 0) this.messages = this.messages.slice(start)
      uni.setStorageSync('agent_history', this.messages)
    },
    scrollToBottom() {
      this.scrollInto = ''
      setTimeout(() => {
        if (!this.alive) return
        this.scrollInto = 'm-bottom'
      }, 60)
    },
    isRefusal(content: string): boolean {
      return content == REFUSAL_MESSAGE
    },
    visibleItems(items: AgentCardItem[]): AgentCardItem[] {
      return items.slice(0, 10)
    },
    isActionDisabled(action: AgentCardAction): boolean {
      const status = action.status
      return status != null && status.length > 0
    },
    onCardAction(action: AgentCardAction, message: ChatMessage, actionIndex: number) {
      if (this.sending) return
      if (this.isActionDisabled(action)) return
      const actions = message.data.actions
      if (actionIndex < 0 || actionIndex >= actions.length) return

      const actionType = action.actionType
      let nextStatus: string = 'done'
      if (actionType == 'cancel_action') nextStatus = 'canceled'
      else if (actionType == 'edit_info') nextStatus = 'edited'
      for (let i = 0; i < actions.length; i++) {
        actions[i].status = i == actionIndex ? nextStatus : 'disabled'
      }

      if (actionType == 'trigger_import_user') {
        this.suggestions = []
        this.appendMessage('user', 'text', action.text, null)
        this.importUsers()
        return
      }
      if (actionType == 'trigger_import_course') {
        this.suggestions = []
        this.appendMessage('user', 'text', action.text, null)
        this.importCourses()
        return
      }
      if (actionType == 'trigger_export_checkin') {
        this.suggestions = []
        this.appendMessage('user', 'text', action.text, null)
        this.exportCheckins()
        return
      }

      const url = action.url
      if (url != null && url.length > 0) {
        uni.navigateTo({ url: url })
        return
      }
      if (actionType == null || actionType.length == 0) return

      this.appendMessage('user', 'text', action.text, null)
      let command = '/' + actionType
      if (actionType.startsWith('/')) command = actionType
      const reply = processMessage(command, 'admin', '')
      const nextSuggestions: string[] = reply.suggestions == null ? [] : reply.suggestions
      if (reply.type == 'card') {
        this.appendMessage('agent', 'card', reply.content, reply.data, nextSuggestions)
      } else {
        this.appendMessage('agent', 'text', reply.content, reply.data, nextSuggestions)
      }
    },
    importUsers() {
      chooseCSVFile((csvText: string) => {
        if (!this.alive) return
        const rows = parseCSVToObjects(csvText)
        let count = 0
        let maxId = 0
        for (let i = 0; i < users.length; i++) {
          if (users[i].id > maxId) maxId = users[i].id
        }
        for (let i = 0; i < rows.length; i++) {
          const row = rows[i]
          let name = csvGet(row, 'name')
          if (name.length == 0) name = csvGet(row, '姓名')
          let studentNo = csvGet(row, 'studentNo').toUpperCase()
          if (studentNo.length == 0) studentNo = csvGet(row, '学号').toUpperCase()
          if (name.length == 0 || studentNo.length == 0) continue
          let exists = false
          for (let j = 0; j < users.length; j++) {
            if (users[j].studentNo == studentNo) exists = true
          }
          if (exists) continue
          let role: 'student' | 'teacher' | 'admin' = 'student'
          const roleValue = csvGet(row, 'role').toLowerCase()
          if (roleValue.includes('teacher') || roleValue.includes('老师') || roleValue.includes('教师')) role = 'teacher'
          else if (roleValue.includes('admin') || roleValue.includes('管理员')) role = 'admin'
          const newUser: User = {
            id: maxId + count + 1,
            name: name,
            studentNo: studentNo,
            role: role
          }
          let phone = csvGet(row, 'phone')
          if (phone.length == 0) phone = csvGet(row, '手机')
          let email = csvGet(row, 'email')
          if (email.length == 0) email = csvGet(row, '邮箱')
          if (phone.length > 0) newUser.phone = phone
          if (email.length > 0) newUser.email = email
          users.push(newUser)
          count += 1
        }
        uni.showToast({ title: '已导入 ' + count.toString() + ' 位用户', icon: 'none' })
        this.appendMessage('agent', 'text', '已导入 ' + count.toString() + ' 位用户。', null, DEFAULT_SUGGESTIONS)
      })
    },
    importCourses() {
      chooseCSVFile((csvText: string) => {
        if (!this.alive) return
        const rows = parseCSVToObjects(csvText)
        let count = 0
        let maxId = 0
        for (let i = 0; i < courses.length; i++) {
          if (courses[i].id > maxId) maxId = courses[i].id
        }
        for (let i = 0; i < rows.length; i++) {
          const row = rows[i]
          let name = csvGet(row, 'name')
          if (name.length == 0) name = csvGet(row, '课程名称')
          const startTime = csvGet(row, 'startTime')
          if (name.length == 0 || startTime.length == 0) continue
          let latitude = Number(csvGet(row, 'latitude'))
          let longitude = Number(csvGet(row, 'longitude'))
          if (isNaN(latitude)) latitude = 0
          if (isNaN(longitude)) longitude = 0
          let signStart = csvGet(row, 'signStart')
          let signEnd = csvGet(row, 'signEnd')
          if (signStart.length == 0) signStart = startTime
          if (signEnd.length == 0) signEnd = startTime
          let teacherName = csvGet(row, 'teacherName')
          if (teacherName.length == 0) teacherName = '未指定'
          const newCourse: Course = {
            id: maxId + count + 1,
            name: name,
            latitude: latitude,
            longitude: longitude,
            startTime: startTime,
            signStart: signStart,
            signEnd: signEnd,
            teacherName: teacherName
          }
          let location = csvGet(row, 'location')
          if (location.length == 0) location = csvGet(row, '地点')
          if (location.length > 0) newCourse.location = location
          courses.push(newCourse)
          count += 1
        }
        uni.showToast({ title: '已导入 ' + count.toString() + ' 门课程', icon: 'none' })
        this.appendMessage('agent', 'text', '已导入 ' + count.toString() + ' 门课程。', null, DEFAULT_SUGGESTIONS)
      })
    },
    exportCheckins() {
      const count = checkinTable.length
      exportCheckinsToCSV(checkinTable)
      this.appendMessage('agent', 'text', '已导出 ' + count.toString() + ' 条签到记录。', null, DEFAULT_SUGGESTIONS)
    }
  }
}
</script>

<style>
