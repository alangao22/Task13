  height: 2rpx;
}

/* ---------------- 输入区 ---------------- */
.composer {
  flex-shrink: 0;
  padding: 8rpx 24rpx 24rpx;
  background-color: #f5f6fa;
}

.chips {
  width: 100%;
  height: 64rpx;
  margin-bottom: 16rpx;
}

.chips-inner {
  height: 64rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
}

.chip {
  height: 60rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
