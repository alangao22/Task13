// utils/agentEngine.uts
// 基于规则的签到业务 Agent 引擎（纯前端模拟，不调用任何外部服务）。
//
// 防御顺序：
// 1. 长度限制 -> 2. 归一化（全角/零宽/空白）-> 3. 敏感词 + 注入正则拦截
// 4. 待确认删除动作 -> 5. 业务意图白名单 -> 6. 统一兜底话术
//
// 引擎只读 / 操作三张业务表：users、courses、checkinTable。
// 删除类操作必须经过"二次确认"，且拒绝批量清空与受保护数据。

import { users, type User } from './userData.uts'
import { courses, type Course } from './courseData.uts'
import { checkinTable, type CheckinRecord } from './checkinData.uts'

export type AgentReplyType = 'text' | 'card' | 'error'

export type AgentCardItem = {
  title: string
  subtitle: string
  badge: string
  badgeType: string
}

export type AgentCardAction = {
  text: string
  url?: string
  actionType?: string
  status?: string // '' | done | canceled | edited | disabled
}

export type AgentCard = {
  title: string
  subtitle: string
  count: number
  items: AgentCardItem[]
  actions: AgentCardAction[]
}

export type AgentReply = {
  type: AgentReplyType
  content: string
  data: AgentCard
  suggestions?: string[]
}

export type ChatMessage = {
  id: string
  role: 'user' | 'agent'
  type: 'text' | 'card'
  content: string
  data: AgentCard
  suggestions?: string[]
}

// 命中黑名单或未匹配到任何业务意图时，统一使用这句话。
export const REFUSAL_MESSAGE: string = '我是签到业务助理，仅支持处理用户、课程和签到数据的查询与操作哦。'

// 所有取消/中断路径统一使用这句话。
const CANCEL_MESSAGE: string = '好的，已为您取消当前操作。您可以随时发起新的指令。'

const MAX_INPUT_LENGTH: number = 120

// ------------------------------ 业务词表 ------------------------------

